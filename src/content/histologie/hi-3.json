{"file": "histology/3)Histologiedesorganeshematopoïetiques__EN.pptx", "chapterId": "hi-3", "title": "Histologie des organes hématopoïétiques", "kind": "cours", "pages": [{"n": 1, "title": "Blood-forming organs (Part One) bone marrow – lymph node MALT tissue", "blocks": [{"type": "heading", "level": 3, "text": "Blood-forming organs (Part One) bone marrow – lymph node MALT tissue"}, {"type": "paragraph", "text": "Dr H. BOUZERIA CPMC Algiers"}, {"type": "image", "src": "/content/histologie/hi-3/img-001.jpg", "caption": "Blood-forming organs (Part One) bone marrow – lymph node MALT tissue"}]}, {"n": 2, "title": "", "blocks": [{"type": "paragraph", "text": "I –Introduction to the hematopoietic organs."}, {"type": "paragraph", "text": "General"}, {"type": "paragraph", "text": "Embryology Bone marrow lines"}, {"type": "paragraph", "text": "II-Bone marrow."}, {"type": "paragraph", "text": "Definition"}, {"type": "paragraph", "text": "Structure"}, {"type": "paragraph", "text": "Histo-physiology"}, {"type": "paragraph", "text": "III-Lymph node."}, {"type": "paragraph", "text": "Reminders about the lymphatic system."}, {"type": "paragraph", "text": "Definition"}, {"type": "paragraph", "text": "Structure"}, {"type": "paragraph", "text": "Vascularization"}, {"type": "paragraph", "text": "Histo-physiology"}, {"type": "paragraph", "text": "IV-Disseminated lymphoid tissue."}]}, {"n": 3, "title": "INTRODUCTION", "blocks": [{"type": "heading", "level": 3, "text": "INTRODUCTION"}, {"type": "paragraph", "text": "The hematopoietic organs are organs which ensure hematopoiesis, their topography, their texture (structure) as well as their function vary according to the age of the individual."}]}, {"n": 4, "title": "DEFINITION", "blocks": [{"type": "heading", "level": 3, "text": "DEFINITION"}, {"type": "paragraph", "text": "Hematopoiesis: corresponds to the different stages of"}, {"type": "paragraph", "text": "Differentiation + maturation"}, {"type": "paragraph", "text": "Figurative elements of blood"}, {"type": "image", "src": "/content/histologie/hi-3/img-002.jpg", "caption": "DEFINITION"}]}, {"n": 5, "title": "", "blocks": [{"type": "paragraph", "text": "Pluripotent stem cell"}, {"type": "paragraph", "text": "Or “CFU”"}, {"type": "paragraph", "text": "Myeloid stem cell"}, {"type": "paragraph", "text": "Lymphoid stem cell"}, {"type": "paragraph", "text": "LT mother cell"}, {"type": "paragraph", "text": "LB mother cell"}, {"type": "paragraph", "text": "T lymphoblasts"}, {"type": "paragraph", "text": "T lymphocytes"}, {"type": "paragraph", "text": "B lymphoblasts"}, {"type": "paragraph", "text": "B lymphocytes"}, {"type": "paragraph", "text": "Mother cell"}, {"type": "paragraph", "text": "neutrophilic and monocytic"}, {"type": "paragraph", "text": "Mother cell"}, {"type": "paragraph", "text": "neutrophil"}, {"type": "paragraph", "text": "Mother cell"}, {"type": "paragraph", "text": "monocytic"}, {"type": "paragraph", "text": "Monoblast"}, {"type": "paragraph", "text": "Monocyte"}, {"type": "paragraph", "text": "Myeloblast"}, {"type": "paragraph", "text": "Promyelocyte"}, {"type": "paragraph", "text": "Neutrophil myelocyte"}, {"type": "paragraph", "text": "Neutrophil metamyelocyte"}, {"type": "paragraph", "text": "Neutrophil granulocyte"}, {"type": "paragraph", "text": "Mother cell"}, {"type": "paragraph", "text": "erythrocyte"}, {"type": "paragraph", "text": "Mother cell"}, {"type": "paragraph", "text": "Megakaryocytic"}, {"type": "paragraph", "text": "Mother cell"}, {"type": "paragraph", "text": "eosinophil"}, {"type": "paragraph", "text": "Mother cell"}, {"type": "paragraph", "text": "basophil"}, {"type": "paragraph", "text": "Eosinophilic granulocyte"}, {"type": "paragraph", "text": "Megakaryoblast"}, {"type": "paragraph", "text": "Basophilic megakaryoblast"}, {"type": "paragraph", "text": "Granular megakaryoblast"}, {"type": "paragraph", "text": "Thrombocytogenic megakaryoblast"}, {"type": "paragraph", "text": "Platelets"}, {"type": "paragraph", "text": "Proerythroblast"}, {"type": "paragraph", "text": "Basophilic erythroblast"}, {"type": "paragraph", "text": "Polychromatophilic erythroblast"}, {"type": "paragraph", "text": "Acidophilic erythroblast"}, {"type": "paragraph", "text": "Reticulocyte"}, {"type": "paragraph", "text": "Red blood cell"}, {"type": "paragraph", "text": "Basophilic granulocyte"}, {"type": "paragraph", "text": "Pluripotent stem cell"}, {"type": "paragraph", "text": "HEMATOPOIESIS"}]}, {"n": 6, "title": "", "blocks": [{"type": "paragraph", "text": "Blood-forming organs"}, {"type": "paragraph", "text": "Are of 2 types"}, {"type": "paragraph", "text": "Myeloid tissue"}, {"type": "paragraph", "text": "Lymphoid tissue"}, {"type": "paragraph", "text": "Hematogenous bone marrow"}, {"type": "paragraph", "text": "Lymphoid organs"}, {"type": "paragraph", "text": "lymphoid infiltrates"}, {"type": "paragraph", "text": "Nodes"}, {"type": "paragraph", "text": "lymphatics"}, {"type": "paragraph", "text": "Missed"}, {"type": "paragraph", "text": "Thymus"}, {"type": "paragraph", "text": "Disseminated lymphoid tissue “MALT”"}]}, {"n": 7, "title": "", "blocks": [{"type": "paragraph", "text": "Thymus"}, {"type": "paragraph", "text": "Missed"}, {"type": "paragraph", "text": "Bone marrow"}, {"type": "paragraph", "text": "Lymph nodes"}, {"type": "paragraph", "text": "Lymphatic vessels"}, {"type": "paragraph", "text": "Pay Plates"}, {"type": "paragraph", "text": "Appendix"}, {"type": "paragraph", "text": "Adenoids"}, {"type": "image", "src": "/content/histologie/hi-3/img-003.png", "caption": ""}]}, {"n": 8, "title": "", "blocks": [{"type": "paragraph", "text": "CLASSIFICATION OF ORGANS"}, {"type": "paragraph", "text": "HEMATOPOIETIC"}]}, {"n": 9, "title": "", "blocks": [{"type": "paragraph", "text": "Blood-forming organs"}, {"type": "paragraph", "text": "Primary"}, {"type": "paragraph", "text": "Secondary"}, {"type": "paragraph", "text": "Bone marrow"}, {"type": "paragraph", "text": "Thymus"}, {"type": "paragraph", "text": "Lymph nodes"}, {"type": "paragraph", "text": "Missed"}, {"type": "paragraph", "text": "Disseminated lymphoid tissue"}]}, {"n": 10, "title": "", "blocks": [{"type": "paragraph", "text": "I –Introduction to the hematopoietic organs."}, {"type": "paragraph", "text": "General"}, {"type": "paragraph", "text": "Embryology"}, {"type": "paragraph", "text": "Bone marrow lines"}, {"type": "paragraph", "text": "II-Bone marrow."}, {"type": "paragraph", "text": "Definition"}, {"type": "paragraph", "text": "Structure"}, {"type": "paragraph", "text": "Histo-physiology"}, {"type": "paragraph", "text": "III-Lymph node."}, {"type": "paragraph", "text": "General information on the lymphatic system."}, {"type": "paragraph", "text": "Definition"}, {"type": "paragraph", "text": "Structure"}, {"type": "paragraph", "text": "Vascularization"}, {"type": "paragraph", "text": "Histo-physiology"}, {"type": "paragraph", "text": "IV-Disseminated lymphoid tissue."}]}, {"n": 11, "title": "", "blocks": [{"type": "paragraph", "text": "The embryological origin of organs"}, {"type": "paragraph", "text": "hematopoietic is twofold:"}, {"type": "paragraph", "text": "It is mesoblastic for all hematopoietic organs except for the thymus which has a dual embryological origin, mesoblastic and entoblast (because the reticular cells of the framework of the thymus are of entoblast origin)."}]}, {"n": 12, "title": "", "blocks": [{"type": "paragraph", "text": "LOCATIONS OF HEMATOPOIESIS:"}, {"type": "paragraph", "text": "We define 3 successive periods from embryonic life to adulthood:"}, {"type": "paragraph", "text": "a/ Pre-hepatic or mesoblastic period: from the 3rd week until the end of the 2nd month of intrauterine life."}, {"type": "paragraph", "text": "Appearance of primordial blood cells in the extra-embryonic mesenchyme (near the yolk sac), in the form of cell clusters called Wolff and Pander islets."}, {"type": "paragraph", "text": "b/ hepatosplenic period: from the 3rd month to the 8th month of intrauterine life: the blood cells migrate into the liver then into the spleen with significant hematopoietic activity in the spleen and especially in the liver."}, {"type": "paragraph", "text": "c/ lymphomedullary period: Migration of blood cells in the bone marrow and lymphoid tissue: It begins between the 4th -5th month of fetal life and continues throughout the life of the individual."}]}, {"n": 13, "title": "", "blocks": [{"type": "paragraph", "text": "Yolk sac"}, {"type": "paragraph", "text": "Embryonic spot"}, {"type": "paragraph", "text": "Allantoid"}, {"type": "paragraph", "text": "Embryonic pedicle"}, {"type": "paragraph", "text": "Wolff and Pander islands"}, {"type": "paragraph", "text": "LOCATIONS OF HEMATOPOIESIS"}, {"type": "paragraph", "text": "03 week human embryo (Sagittal section)"}, {"type": "image", "src": "/content/histologie/hi-3/img-004.png", "caption": ""}]}, {"n": 14, "title": "", "blocks": [{"type": "paragraph", "text": "Locations of hematopoiesis from embryonic life to birth"}, {"type": "image", "src": "/content/histologie/hi-3/img-005.emf", "caption": ""}]}, {"n": 15, "title": "", "blocks": [{"type": "paragraph", "text": "I –Introduction to the hematopoietic organs."}, {"type": "paragraph", "text": "General"}, {"type": "paragraph", "text": "Embryology Bone marrow lines"}, {"type": "paragraph", "text": "II-Bone marrow."}, {"type": "paragraph", "text": "Definition"}, {"type": "paragraph", "text": "Structure"}, {"type": "paragraph", "text": "Histophysiology"}, {"type": "paragraph", "text": "III-Lymph node."}, {"type": "paragraph", "text": "General information on the lymphatic system."}, {"type": "paragraph", "text": "Definition"}, {"type": "paragraph", "text": "Structure"}, {"type": "paragraph", "text": "Vascularization"}, {"type": "paragraph", "text": "Histophysiology"}, {"type": "paragraph", "text": "IV-Disseminated lymphoid tissue."}]}, {"n": 16, "title": "", "blocks": [{"type": "paragraph", "text": "Pluripotent stem cell"}, {"type": "paragraph", "text": "Or “CFU”"}, {"type": "paragraph", "text": "Myeloid stem cell"}, {"type": "paragraph", "text": "Lymphoid stem cell"}, {"type": "paragraph", "text": "LT mother cell"}, {"type": "paragraph", "text": "LB mother cell"}, {"type": "paragraph", "text": "T lymphoblasts"}, {"type": "paragraph", "text": "T lymphocytes"}, {"type": "paragraph", "text": "B lymphoblasts"}, {"type": "paragraph", "text": "B lymphocytes"}, {"type": "paragraph", "text": "Mother cell"}, {"type": "paragraph", "text": "neutrophilic and monocytic"}, {"type": "paragraph", "text": "Mother cell"}, {"type": "paragraph", "text": "neutrophil"}, {"type": "paragraph", "text": "Mother cell"}, {"type": "paragraph", "text": "monocytic"}, {"type": "paragraph", "text": "Monoblast"}, {"type": "paragraph", "text": "Monocyte"}, {"type": "paragraph", "text": "Myeloblast"}, {"type": "paragraph", "text": "Promyelocyte"}, {"type": "paragraph", "text": "Neutrophil myelocyte"}, {"type": "paragraph", "text": "Neutrophil metamyelocyte"}, {"type": "paragraph", "text": "Neutrophil granulocyte"}, {"type": "paragraph", "text": "Mother cell"}, {"type": "paragraph", "text": "erythrocyte"}, {"type": "paragraph", "text": "Mother cell"}, {"type": "paragraph", "text": "Megakaryocytic"}, {"type": "paragraph", "text": "Mother cell"}, {"type": "paragraph", "text": "eosinophil"}, {"type": "paragraph", "text": "Mother cell"}, {"type": "paragraph", "text": "basophil"}, {"type": "paragraph", "text": "Eosinophilic granulocyte"}, {"type": "paragraph", "text": "Megakaryoblast"}, {"type": "paragraph", "text": "Basophilic megakaryoblast"}, {"type": "paragraph", "text": "Granular megakaryoblast"}, {"type": "paragraph", "text": "Thrombocytogenic megakaryoblast"}, {"type": "paragraph", "text": "Platelets"}, {"type": "paragraph", "text": "Proerythroblast"}, {"type": "paragraph", "text": "Basophilic erythroblast"}, {"type": "paragraph", "text": "Polychromatophilic erythroblast"}, {"type": "paragraph", "text": "Acidophilic erythroblast"}, {"type": "paragraph", "text": "Reticulocyte"}, {"type": "paragraph", "text": "Red blood cell"}, {"type": "paragraph", "text": "Basophilic granulocyte"}, {"type": "paragraph", "text": "Pluripotent stem cell"}, {"type": "paragraph", "text": "HEMATOPOIESIS"}]}, {"n": 17, "title": "", "blocks": [{"type": "paragraph", "text": "I –Introduction to the hematopoietic organs."}, {"type": "paragraph", "text": "General"}, {"type": "paragraph", "text": "Bone marrow lineage embryology"}, {"type": "paragraph", "text": "II-Bone marrow."}, {"type": "paragraph", "text": "Definition"}, {"type": "paragraph", "text": "Structure"}, {"type": "paragraph", "text": "Histo-physiology"}, {"type": "paragraph", "text": "III-Lymph node."}, {"type": "paragraph", "text": "General information on the lymphatic system."}, {"type": "paragraph", "text": "Definition"}, {"type": "paragraph", "text": "Structure"}, {"type": "paragraph", "text": "Vascularization"}, {"type": "paragraph", "text": "Histo-physiology"}, {"type": "paragraph", "text": "IV-Disseminated lymphoid tissue."}]}, {"n": 18, "title": "", "blocks": [{"type": "paragraph", "text": "BONE MARROW:"}, {"type": "paragraph", "text": "It is the unique location of hematopoiesis after birth."}, {"type": "paragraph", "text": "Found in the cavities of the spongy bone and the medullary cavities of"}, {"type": "paragraph", "text": "diaphyses and weighs between 2 and 4 kg."}, {"type": "paragraph", "text": "There are 3 types of bone marrow:"}, {"type": "paragraph", "text": "Hematogenous red bone marrow"}, {"type": "paragraph", "text": "Yellow pith"}, {"type": "paragraph", "text": "Gray pith"}, {"type": "paragraph", "text": "Sternal bones, coxal bones (iliac bones)"}, {"type": "paragraph", "text": "Spongy bones of the skull,"}, {"type": "paragraph", "text": "Vertebrae, ribs,"}, {"type": "paragraph", "text": "epiphysis of the humerus"}, {"type": "paragraph", "text": "and femur"}, {"type": "paragraph", "text": "Long bone marrow gradually loses its activity and is invaded by fat cells"}, {"type": "paragraph", "text": "Fibrous: fibrosis replaces the yellow marrow"}, {"type": "paragraph", "text": "Child and young adult: found in the cavities of all bones:"}, {"type": "paragraph", "text": "Found in elderly subjects"}, {"type": "paragraph", "text": "Found in adults"}]}, {"n": 19, "title": "", "blocks": [{"type": "paragraph", "text": "I –Introduction to the hematopoietic organs."}, {"type": "paragraph", "text": "General"}, {"type": "paragraph", "text": "Embryology Bone marrow lines"}, {"type": "paragraph", "text": "II-Bone marrow."}, {"type": "paragraph", "text": "Definition"}, {"type": "paragraph", "text": "Structure"}, {"type": "paragraph", "text": "Histo-physiology"}, {"type": "paragraph", "text": "III-Lymph node."}, {"type": "paragraph", "text": "General information on the lymphatic system."}, {"type": "paragraph", "text": "Definition"}, {"type": "paragraph", "text": "Structure"}, {"type": "paragraph", "text": "Vascularization"}, {"type": "paragraph", "text": "Histo-physiology"}, {"type": "paragraph", "text": "IV-Disseminated lymphoid tissue."}]}, {"n": 20, "title": "", "blocks": [{"type": "paragraph", "text": "OsteoMedullary Biopsy (OMB)"}, {"type": "paragraph", "text": "The biopsy of the posterior iliac crest yields a small cylindrical fragment (= core) of bone marrow 15 -30 mm long and 1.2 – 1.5 mm in diameter."}, {"type": "paragraph", "text": "This bone marrow fragment is fixed then decalcified then dehydrated and embedded in paraffin."}, {"type": "paragraph", "text": "The fragment is then cut longitudinally into thin sections (= paraffin sections) 3 µm thick."}, {"type": "paragraph", "text": "The sections are deparaffinized and stained with several techniques."}, {"type": "image", "src": "/content/histologie/hi-3/img-006.png", "caption": ""}]}, {"n": 21, "title": "", "blocks": [{"type": "image", "src": "/content/histologie/hi-3/img-007.jpg", "caption": ""}]}, {"n": 22, "title": "", "blocks": [{"type": "paragraph", "text": "the bone lamellae (red) delimit cells, containing hematopoiesis cells (in purple) and fat globules (translucent areas) (HES coloring)."}, {"type": "image", "src": "/content/histologie/hi-3/img-008.jpg", "caption": ""}]}, {"n": 23, "title": "", "blocks": [{"type": "paragraph", "text": "Bone lamella"}, {"type": "paragraph", "text": "Granulocyte"}, {"type": "paragraph", "text": "Megakaryocyte"}, {"type": "paragraph", "text": "Erythroblastic island"}, {"type": "paragraph", "text": "Histological section of bone marrow observed under a light microscope"}, {"type": "image", "src": "/content/histologie/hi-3/img-009.png", "caption": ""}]}, {"n": 24, "title": "", "blocks": [{"type": "paragraph", "text": "Bone marrow observed under a high magnification light microscope"}, {"type": "image", "src": "/content/histologie/hi-3/img-010.jpg", "caption": ""}]}, {"n": 25, "title": "", "blocks": [{"type": "paragraph", "text": "Orthochromatic normoblast"}, {"type": "paragraph", "text": "Diagram representing a histological section of BM observed under an optical microscope"}, {"type": "image", "src": "/content/histologie/hi-3/img-011.png", "caption": ""}, {"type": "image", "src": "/content/histologie/hi-3/img-012.jpg", "caption": ""}]}, {"n": 26, "title": "", "blocks": [{"type": "paragraph", "text": "The bone marrow examined under medium magnification appears to be made up of a heterogeneous set of cells:"}, {"type": "paragraph", "text": "1 - Adipose cells or adipocytes."}, {"type": "paragraph", "text": "2 - large cells with budding nuclei: these are megakaryocytes."}, {"type": "paragraph", "text": "3 -Polymorphic cells: corresponds to cells of different lineages at different stages of maturation (different stages of hematopoiesis)"}]}, {"n": 27, "title": "", "blocks": [{"type": "paragraph", "text": "THE BONE MARROW PARENCHYMA"}, {"type": "paragraph", "text": "The cells of the marrow are found in a parenchyma, the latter is made up of:"}, {"type": "paragraph", "text": "1/ A frame: composed of reticulin fibers and reticular cells."}, {"type": "paragraph", "text": "2/Sinusoid capillaries: have a discontinuous wall and absence of basement membrane."}]}, {"n": 28, "title": "", "blocks": [{"type": "paragraph", "text": "Orthochromatic normoblast"}, {"type": "paragraph", "text": "Diagram representing a histological section of BM observed under an optical microscope"}, {"type": "image", "src": "/content/histologie/hi-3/img-011.png", "caption": ""}]}, {"n": 29, "title": "", "blocks": [{"type": "paragraph", "text": "I –Introduction to the hematopoietic organs."}, {"type": "paragraph", "text": "General"}, {"type": "paragraph", "text": "Embryology Bone marrow lines"}, {"type": "paragraph", "text": "II-Bone marrow."}, {"type": "paragraph", "text": "Definition"}, {"type": "paragraph", "text": "Structure"}, {"type": "paragraph", "text": "Histophysiology"}, {"type": "paragraph", "text": "III-Lymph node."}, {"type": "paragraph", "text": "General information on the lymphatic system."}, {"type": "paragraph", "text": "Definition"}, {"type": "paragraph", "text": "Structure"}, {"type": "paragraph", "text": "Vascularization"}, {"type": "paragraph", "text": "Histophysiology"}, {"type": "paragraph", "text": "IV-Disseminated lymphoid tissue."}, {"type": "image", "src": "/content/histologie/hi-3/img-013.jpg", "caption": ""}]}, {"n": 30, "title": "", "blocks": [{"type": "paragraph", "text": "I –Introduction to the hematopoietic organs."}, {"type": "paragraph", "text": "General"}, {"type": "paragraph", "text": "Embryology Bone marrow lines"}, {"type": "paragraph", "text": "II-Bone marrow."}, {"type": "paragraph", "text": "Definition"}, {"type": "paragraph", "text": "Structure"}, {"type": "paragraph", "text": "Histophysiology"}, {"type": "paragraph", "text": "III-Lymph node."}, {"type": "paragraph", "text": "General information on the lymphatic system."}, {"type": "paragraph", "text": "Definition"}, {"type": "paragraph", "text": "Structure"}, {"type": "paragraph", "text": "Vascularization"}, {"type": "paragraph", "text": "Histophysiology"}, {"type": "paragraph", "text": "IV-Disseminated lymphoid tissue."}]}, {"n": 31, "title": "", "blocks": [{"type": "paragraph", "text": "HEMATOPOIESIS AND LYMPHOPOIESIS."}, {"type": "paragraph", "text": "DESTRUCTION OF AGED RED BLOOD CELLS USING “MACROPAGES”"}, {"type": "paragraph", "text": "DEFENSE OF THE ORGANIZATION BY"}, {"type": "paragraph", "text": "HUMORAL AND CELLULAR IMMUNITY"}, {"type": "paragraph", "text": "HISTOPHYSIOLOGY OF THE BONE MARROW"}]}, {"n": 32, "title": "", "blocks": [{"type": "paragraph", "text": "I –Introduction to the hematopoietic organs."}, {"type": "paragraph", "text": "General"}, {"type": "paragraph", "text": "Embryology Bone marrow lines"}, {"type": "paragraph", "text": "II-Bone marrow."}, {"type": "paragraph", "text": "Definition"}, {"type": "paragraph", "text": "Structure"}, {"type": "paragraph", "text": "Histophysiology"}, {"type": "paragraph", "text": "III-Lymph node."}, {"type": "paragraph", "text": "General information on the lymphatic system."}, {"type": "paragraph", "text": "Definition"}, {"type": "paragraph", "text": "Structure"}, {"type": "paragraph", "text": "Vascularization"}, {"type": "paragraph", "text": "Histophysiology"}, {"type": "paragraph", "text": "IV-Disseminated lymphoid tissue."}]}, {"n": 33, "title": "", "blocks": [{"type": "paragraph", "text": "Thoracic duct"}, {"type": "paragraph", "text": "Axillary lymph node"}, {"type": "paragraph", "text": "Missed"}, {"type": "paragraph", "text": "Pay plaque of the small intestine"}, {"type": "paragraph", "text": "Inguinal lymph node"}, {"type": "paragraph", "text": "Iliac lymph node"}, {"type": "paragraph", "text": "Palatine tonsil"}, {"type": "paragraph", "text": "Submandibular ganglion"}, {"type": "paragraph", "text": "Cervical lymph node"}, {"type": "paragraph", "text": "Right lymphatic channel"}, {"type": "paragraph", "text": "Thymus"}, {"type": "paragraph", "text": "Lymphatic vessel"}, {"type": "paragraph", "text": "Tank"}, {"type": "paragraph", "text": "Intestinal lymph node"}, {"type": "paragraph", "text": "Appendix"}, {"type": "paragraph", "text": "Thoracic duct"}, {"type": "paragraph", "text": "The lymphatic system is a"}, {"type": "paragraph", "text": "“circuit”, made up of all the lymphatic vessels and nodes but also organs"}, {"type": "paragraph", "text": "Organization of lymphoid tissue"}, {"type": "image", "src": "/content/histologie/hi-3/img-014.png", "caption": ""}]}, {"n": 34, "title": "", "blocks": [{"type": "paragraph", "text": "Reminders on lymphatic circulation"}, {"type": "paragraph", "text": "The interstitial fluid circulating in the lymphatic vessels is called lymph."}, {"type": "paragraph", "text": "Lymph comes from the blood, accumulates in the interstitial sector and then circulates in the lymphatic vessels."}, {"type": "paragraph", "text": "The lymphatic system intervenes in the body's defense process by allowing defense cells to circulate throughout the body and thus activate the so-called specific immune response."}, {"type": "paragraph", "text": "Capillary network"}, {"type": "paragraph", "text": "Capillary network"}, {"type": "paragraph", "text": "Lymphatic vessels"}, {"type": "paragraph", "text": "Lymph node"}, {"type": "image", "src": "/content/histologie/hi-3/img-015.png", "caption": ""}]}, {"n": 35, "title": "", "blocks": [{"type": "paragraph", "text": "LYMPH: Comes from the blood,"}, {"type": "paragraph", "text": "Translucent organic liquid whose composition is close to plasma. Immune role."}, {"type": "image", "src": "/content/histologie/hi-3/img-016.jpg", "caption": ""}]}, {"n": 36, "title": "", "blocks": [{"type": "paragraph", "text": "Lymphoid infiltrate"}, {"type": "paragraph", "text": "Lymphoid nodule"}, {"type": "paragraph", "text": "Simple cellular clusters without precise boundaries"}, {"type": "paragraph", "text": "Very limited training."}, {"type": "paragraph", "text": "May be primary or secondary. The secondary has a germinal center made of activated B lymphocytes"}, {"type": "paragraph", "text": "Organization of lymphoid tissue"}, {"type": "paragraph", "text": "Primary lymphoid nodule"}, {"type": "paragraph", "text": "Secondary lymphoid nodule"}, {"type": "paragraph", "text": "Fleming Germinal Center"}, {"type": "paragraph", "text": "Lymphocytes"}, {"type": "image", "src": "/content/histologie/hi-3/img-017.png", "caption": ""}]}, {"n": 37, "title": "", "blocks": [{"type": "paragraph", "text": "Histological section of a lymph node observed under a light microscope at medium magnification (secondary lymphoid follicle)"}, {"type": "image", "src": "/content/histologie/hi-3/img-018.jpg", "caption": ""}]}, {"n": 38, "title": "", "blocks": [{"type": "paragraph", "text": "I –Introduction to the hematopoietic organs."}, {"type": "paragraph", "text": "General"}, {"type": "paragraph", "text": "Embryology Bone marrow lines"}, {"type": "paragraph", "text": "II-Bone marrow."}, {"type": "paragraph", "text": "Definition"}, {"type": "paragraph", "text": "Structure"}, {"type": "paragraph", "text": "Histophysiology"}, {"type": "paragraph", "text": "III-Lymph node."}, {"type": "paragraph", "text": "General information on the lymphatic system."}, {"type": "paragraph", "text": "Definition"}, {"type": "paragraph", "text": "Structure"}, {"type": "paragraph", "text": "Vascularization"}, {"type": "paragraph", "text": "Histophysiology"}, {"type": "paragraph", "text": "IV-Disseminated lymphoid tissue."}]}, {"n": 39, "title": "", "blocks": [{"type": "paragraph", "text": "The lymph node is a secondary lymphoid organ, rounded or ovoid, well delimited by a capsule."}, {"type": "paragraph", "text": "Measures between 0.5 to 1 cm in normal state."}, {"type": "paragraph", "text": "The convex part receives the afferent lymphatic vessels"}, {"type": "paragraph", "text": "The concave region corresponds to the HILE of the lymph node; it is the entry point of the lymph node artery and the exit point of the lymph node vein and a single efferent lymphatic vessel."}, {"type": "paragraph", "text": "H"}, {"type": "paragraph", "text": "HILE"}, {"type": "image", "src": "/content/histologie/hi-3/img-019.jpg", "caption": ""}]}, {"n": 40, "title": "", "blocks": [{"type": "image", "src": "/content/histologie/hi-3/img-020.png", "caption": ""}]}, {"n": 41, "title": "", "blocks": [{"type": "paragraph", "text": "I –Introduction to the hematopoietic organs."}, {"type": "paragraph", "text": "General"}, {"type": "paragraph", "text": "Embryology Bone marrow lines"}, {"type": "paragraph", "text": "II-Bone marrow."}, {"type": "paragraph", "text": "Definition"}, {"type": "paragraph", "text": "Structure"}, {"type": "paragraph", "text": "Histophysiology"}, {"type": "paragraph", "text": "III-Lymph node."}, {"type": "paragraph", "text": "General information on the lymphatic system."}, {"type": "paragraph", "text": "Definition"}, {"type": "paragraph", "text": "Structure"}, {"type": "paragraph", "text": "Vascularization"}, {"type": "paragraph", "text": "Histophysiology"}, {"type": "paragraph", "text": "IV-Disseminated lymphoid tissue."}]}, {"n": 42, "title": "", "blocks": [{"type": "paragraph", "text": "STRUCTURE OF THE LYMPHATIC NODE:"}, {"type": "paragraph", "text": "Low-magnification optical microscope examination of a longitudinal section"}, {"type": "paragraph", "text": "of a lymph node (and after staining with hemalun eosin), shows:"}, {"type": "paragraph", "text": "-A fibro-elastic envelope capsule, surrounded by adipose tissue, the capsule"}, {"type": "paragraph", "text": "emits connective trabeculae which converge towards the hilum delimiting the cubicles."}, {"type": "paragraph", "text": "Between the capsule and the different trabeculae, numerous fibers of"}, {"type": "paragraph", "text": "reticulins and reticular cells constituting the reticular framework."}, {"type": "paragraph", "text": "- The lymph node parenchyma is represented by two very distinct zones;"}, {"type": "paragraph", "text": "a dense and dark cortical, peripheral area rich in lymphoid nodules which are located in the cubicles (2 to 3 lymphoid follicles or nodules per cubicle and they are either primary or secondary)."}, {"type": "paragraph", "text": "a deep, clear medullary area with follicular cords."}, {"type": "paragraph", "text": "And a para-cortical zone, less distinct, located between the cortical zone and the medullary zone."}]}, {"n": 43, "title": "", "blocks": [{"type": "paragraph", "text": "Histological section of a lymph node observed under a light microscope at low magnification"}, {"type": "image", "src": "/content/histologie/hi-3/img-021.jpg", "caption": ""}]}, {"n": 44, "title": "", "blocks": [{"type": "paragraph", "text": "Capsule and connective framework"}, {"type": "paragraph", "text": "Capsule"}, {"type": "paragraph", "text": "Interfollicular septum"}, {"type": "paragraph", "text": "Intercordonal spans"}, {"type": "paragraph", "text": "Diagram representing the capsule and connective framework of a lymph node"}]}, {"n": 45, "title": "", "blocks": [{"type": "paragraph", "text": "Reticulin fibers and reticular cells = The Weft"}, {"type": "paragraph", "text": "Diagram representing the reticular framework of a lymph node"}]}, {"n": 46, "title": "", "blocks": [{"type": "paragraph", "text": "Cellular and fibrillar framework of a lymph node"}, {"type": "paragraph", "text": "Reticular cells"}, {"type": "paragraph", "text": "Reticulin fibers"}, {"type": "paragraph", "text": "Lymphocyte"}, {"type": "image", "src": "/content/histologie/hi-3/img-022.png", "caption": ""}]}, {"n": 47, "title": "The reticular cell", "blocks": [{"type": "heading", "level": 3, "text": "The reticular cell"}, {"type": "image", "src": "/content/histologie/hi-3/img-023.png", "caption": "The reticular cell"}]}, {"n": 48, "title": "", "blocks": [{"type": "image", "src": "/content/histologie/hi-3/img-024.png", "caption": ""}]}, {"n": 49, "title": "Lymph node; medullary area", "blocks": [{"type": "heading", "level": 3, "text": "Lymph node; medullary area"}, {"type": "paragraph", "text": "Histological section of a lymph node observed under a light microscope at medium magnification"}, {"type": "image", "src": "/content/histologie/hi-3/img-025.png", "caption": "Lymph node; medullary area"}]}, {"n": 50, "title": "", "blocks": [{"type": "paragraph", "text": "Superficial cortex"}, {"type": "paragraph", "text": "Deep cortex"}, {"type": "paragraph", "text": "Medullary"}, {"type": "paragraph", "text": "L.B."}, {"type": "paragraph", "text": "L.T."}, {"type": "paragraph", "text": "L.B."}, {"type": "paragraph", "text": "Plasma cells"}, {"type": "paragraph", "text": "Plasma cells"}, {"type": "paragraph", "text": "Cellular distribution of the lymph node"}, {"type": "paragraph", "text": "Macrophages"}, {"type": "image", "src": "/content/histologie/hi-3/img-026.png", "caption": ""}]}, {"n": 51, "title": "", "blocks": [{"type": "paragraph", "text": "I –Introduction to the hematopoietic organs."}, {"type": "paragraph", "text": "General"}, {"type": "paragraph", "text": "Embryology Bone marrow lines"}, {"type": "paragraph", "text": "II-Bone marrow."}, {"type": "paragraph", "text": "Definition"}, {"type": "paragraph", "text": "Structure"}, {"type": "paragraph", "text": "Histophysiology"}, {"type": "paragraph", "text": "III-Lymph node."}, {"type": "paragraph", "text": "General information on the lymphatic system."}, {"type": "paragraph", "text": "Definition"}, {"type": "paragraph", "text": "Structure"}, {"type": "paragraph", "text": "Vascularization"}, {"type": "paragraph", "text": "Histophysiology"}, {"type": "paragraph", "text": "IV-Disseminated lymphoid tissue."}]}, {"n": 52, "title": "", "blocks": [{"type": "paragraph", "text": "THE VASCULARIZATION OF THE LYPHATIC NODE IS DOUBLE:"}, {"type": "paragraph", "text": "1/ LYMPHATIC VASCULARIZATION:"}, {"type": "paragraph", "text": "The lymph arrives at the level of the lymph node thanks to the vessels"}, {"type": "paragraph", "text": "afferent lymphatics which border the node by its convex part."}, {"type": "paragraph", "text": "To be cleaned, the lymph passes through the lymph node parenchyma into"}, {"type": "paragraph", "text": "following a path specific to it which is represented by:"}, {"type": "paragraph", "text": "- The marginal sinus or subcapsular sinus."}, {"type": "paragraph", "text": "- The radiated sinus or inter-follicular sinus."}, {"type": "paragraph", "text": "- The cavernous sinus or inter-cordonal sinuses."}, {"type": "paragraph", "text": "Then the lymph leaves the lymph node at the level of the Hilum through a single efferent lymphatic vessel."}]}, {"n": 53, "title": "", "blocks": [{"type": "paragraph", "text": "Marginal sinus"}, {"type": "paragraph", "text": "Sinus radiation"}, {"type": "paragraph", "text": "Cavernous sinus"}, {"type": "paragraph", "text": "Lymphatic and blood circulation in a lymph node"}, {"type": "image", "src": "/content/histologie/hi-3/img-027.png", "caption": ""}]}, {"n": 54, "title": "Lymph node; subcapsular sinus", "blocks": [{"type": "heading", "level": 3, "text": "Lymph node; subcapsular sinus"}, {"type": "paragraph", "text": "Subcapsular Sinus"}, {"type": "paragraph", "text": "Conjunctive Capsule"}, {"type": "paragraph", "text": "Cortical"}, {"type": "image", "src": "/content/histologie/hi-3/img-028.png", "caption": "Lymph node; subcapsular sinus"}]}, {"n": 55, "title": "", "blocks": [{"type": "paragraph", "text": "2/ BLOOD VASCULARIZATION: IMPORTANT ROLE;"}, {"type": "paragraph", "text": "- ENSURES THE NUTRITION AND OXYGENATION OF THE NODE"}, {"type": "paragraph", "text": "- AND THE RECIRCULATION OF LYMPHOCYTES OR HOMING"}, {"type": "paragraph", "text": "(replacement of lymphocytes and macrophages)."}, {"type": "paragraph", "text": "Blood supply is provided by an artery which enters the"}, {"type": "paragraph", "text": "ganglion through the hilum, it gives 2 branches, one cortical and the other"}, {"type": "paragraph", "text": "medullary. The capillaries are then drained by post-"}, {"type": "paragraph", "text": "capillaries at the level of the paracortical, then drained in turn by"}, {"type": "paragraph", "text": "a ganglion vein which exits the ganglion through the Hile to join the"}, {"type": "paragraph", "text": "general circulation."}]}, {"n": 56, "title": "", "blocks": [{"type": "paragraph", "text": "Afferent lymphatic"}, {"type": "paragraph", "text": "Capsule"}, {"type": "paragraph", "text": "Sinus radiation"}, {"type": "paragraph", "text": "Artery"}, {"type": "paragraph", "text": "Vein"}, {"type": "paragraph", "text": "Efferent lymphatic"}, {"type": "paragraph", "text": "Cavernous sinus"}, {"type": "paragraph", "text": "lymphoid follicle"}, {"type": "paragraph", "text": "Follicular cord"}, {"type": "paragraph", "text": "Marginal sinus"}, {"type": "paragraph", "text": "Diagram representing a longitudinal section of a lymph node"}, {"type": "image", "src": "/content/histologie/hi-3/img-029.jpg", "caption": ""}]}, {"n": 57, "title": "", "blocks": [{"type": "paragraph", "text": "I –Introduction to the hematopoietic organs."}, {"type": "paragraph", "text": "General"}, {"type": "paragraph", "text": "Embryology Bone marrow lines"}, {"type": "paragraph", "text": "II-Bone marrow."}, {"type": "paragraph", "text": "Definition"}, {"type": "paragraph", "text": "Structure"}, {"type": "paragraph", "text": "Histophysiology"}, {"type": "paragraph", "text": "III-Lymph node."}, {"type": "paragraph", "text": "General information on the lymphatic system."}, {"type": "paragraph", "text": "Definition"}, {"type": "paragraph", "text": "Structure"}, {"type": "paragraph", "text": "Vascularization"}, {"type": "paragraph", "text": "Histophysiology"}, {"type": "paragraph", "text": "IV-Disseminated lymphoid tissue."}]}, {"n": 58, "title": "", "blocks": [{"type": "paragraph", "text": "HISTOPHYSIOLOGY"}, {"type": "paragraph", "text": "Mechanical filtration﴾ mesh fibers﴿"}, {"type": "paragraph", "text": "Non-specific defense ﴾Macrophages﴿"}, {"type": "paragraph", "text": "Interaction between antigens and immunocompetent cells:"}, {"type": "paragraph", "text": "Humoral immunity (Plasmocytes﴿."}, {"type": "paragraph", "text": "Cellular immunity (T lymphocytes)"}]}, {"n": 59, "title": "", "blocks": [{"type": "paragraph", "text": "Lymphadenopathy: Enlargement of a lymph node in response to"}, {"type": "paragraph", "text": "Local or general antigenic stimulation."}, {"type": "paragraph", "text": "Accumulation of pathological cells."}, {"type": "paragraph", "text": "Primary tumor reaction “lymphoma”"}, {"type": "image", "src": "/content/histologie/hi-3/img-030.jpg", "caption": ""}, {"type": "image", "src": "/content/histologie/hi-3/img-031.png", "caption": ""}]}, {"n": 60, "title": "", "blocks": [{"type": "paragraph", "text": "I –Introduction to the hematopoietic organs."}, {"type": "paragraph", "text": "General"}, {"type": "paragraph", "text": "Embryology Bone marrow lines"}, {"type": "paragraph", "text": "II-Bone marrow."}, {"type": "paragraph", "text": "Definition"}, {"type": "paragraph", "text": "Structure"}, {"type": "paragraph", "text": "Histophysiology"}, {"type": "paragraph", "text": "III-Lymph node."}, {"type": "paragraph", "text": "General information on the lymphatic system."}, {"type": "paragraph", "text": "Definition"}, {"type": "paragraph", "text": "Structure"}, {"type": "paragraph", "text": "Vascularization"}, {"type": "paragraph", "text": "Histophysiology"}, {"type": "paragraph", "text": "IV-Disseminated lymphoid tissue."}]}, {"n": 61, "title": "", "blocks": [{"type": "paragraph", "text": "The mucous membranes of the body are related either to the external environment (respiratory or upper digestive tracts), or to cavities whose environment is external to the body (intestine, urinary tracts)."}, {"type": "paragraph", "text": "These are fragile barriers against attacks by foreign organisms. It is also a privileged place of contact between the immune system and the external environment."}, {"type": "paragraph", "text": "This is why, in all these hollow organs, the wall contains elements of the immune system (especially lymphocytes), constituting the Mucosa-Associated Lymphoid Tissue (MALT)."}]}, {"n": 62, "title": "", "blocks": [{"type": "paragraph", "text": "Lymphoid tissue associated with the nose: adenoids, tonsils"}, {"type": "paragraph", "text": "Lymphoid tissue associated with mucous membranes: MALT"}, {"type": "paragraph", "text": "Mucosae Associated Lymphoid Tissue"}, {"type": "image", "src": "/content/histologie/hi-3/img-032.png", "caption": ""}]}, {"n": 63, "title": "", "blocks": [{"type": "paragraph", "text": "Palatine tonsils,"}, {"type": "paragraph", "text": "The lingual tonsil"}, {"type": "paragraph", "text": "Pharyngeal tonsil"}, {"type": "paragraph", "text": "Tubal tonsils"}, {"type": "paragraph", "text": "Palatine tonsil"}, {"type": "paragraph", "text": "Schematic representation of the interior of the pharynx"}, {"type": "paragraph", "text": "Photo of an open mouth illustrating the palatine tonsils"}, {"type": "image", "src": "/content/histologie/hi-3/img-033.jpg", "caption": ""}, {"type": "image", "src": "/content/histologie/hi-3/img-034.png", "caption": ""}]}, {"n": 64, "title": "", "blocks": [{"type": "paragraph", "text": "Muscle fibers"}, {"type": "paragraph", "text": "Connective chorion"}, {"type": "paragraph", "text": "Amygdala crypt"}, {"type": "paragraph", "text": "Epithelium"}, {"type": "paragraph", "text": "Lymphoid nodules"}, {"type": "paragraph", "text": "Amygdala crypt"}, {"type": "paragraph", "text": "Diagram representing a section of the palatine tonsil observed under a light microscope"}, {"type": "image", "src": "/content/histologie/hi-3/img-035.jpg", "caption": ""}]}, {"n": 65, "title": "", "blocks": [{"type": "paragraph", "text": "Esophagus HE"}, {"type": "paragraph", "text": "Histological section of an esophagus observed under a light microscope"}, {"type": "paragraph", "text": "lymphoid follicle"}]}, {"n": 66, "title": "Peyer's patch (appendix): Lymphoid nodules with germinal centers", "blocks": [{"type": "heading", "level": 3, "text": "Peyer's patch (appendix): Lymphoid nodules with germinal centers"}, {"type": "image", "src": "/content/histologie/hi-3/img-036.png", "caption": "Peyer's patch (appendix): Lymphoid nodules with germinal centers"}]}, {"n": 67, "title": "", "blocks": [{"type": "paragraph", "text": "Large intestine"}, {"type": "paragraph", "text": "Histological section of an intestinal wall observed under a light microscope (closed follicle)"}, {"type": "image", "src": "/content/histologie/hi-3/img-037.png", "caption": ""}]}]}