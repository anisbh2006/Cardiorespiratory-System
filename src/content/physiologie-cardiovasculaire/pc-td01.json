    {
      "n": 33,
      "title": "b- Dérivations précordiales",
      "blocks": [
        {
          "type": "paragraph",
          "text": "ELECTROCARDIOGRAMME (ECG)"
        },
        {
          "type": "heading",
          "level": 3,
          "text": "b- Dérivations précordiales"
        },
        {
          "type": "list",
          "items": [
            "6 leads explorant le heart dans un plan horizontal.",
            "V1, V2, V3, V4, V5 et V6 obtenues en plaçant les electrodes au niveau de la région précordiale."
          ]
        }
      ]
    },
    {
      "n": 34,
      "title": "ELECTROCARDIOGRAMME (ECG)",
      "blocks": [
        {
          "type": "paragraph",
          "text": "ELECTROCARDIOGRAMME (ECG)"
        },
        {
          "type": "paragraph",
          "text": "V1 : 4e intercostal space droit, le long du"
        },
        {
          "type": "paragraph",
          "text": "bord droit du sternum;"
        },
        {
          "type": "paragraph",
          "text": "V2 : 4e intercostal space gauche, le long du"
        },
        {
          "type": "paragraph",
          "text": "bord gauche du sternum"
        },
        {
          "type": "paragraph",
          "text": "V4 : 5e intercostal space gauche, ligne"
        },
        {
          "type": "paragraph",
          "text": "médio-claviculaire ;"
        },
        {
          "type": "paragraph",
          "text": "V3 : à mi-distance entre V2 et V4"
        },
        {
          "type": "paragraph",
          "text": "V5 : sur la même ligne horizontale que V4,"
        },
        {
          "type": "paragraph",
          "text": "ligne antéro-axillaire"
        },
        {
          "type": "paragraph",
          "text": "V6 : sur la même ligne horizontale que V4,"
        },
        {
          "type": "paragraph",
          "text": "ligne médio-axillaire gauche."
        }
      ]
    },
    {
      "n": 35,
      "title": "c- Dérivations non standards :",
      "blocks": [
        {
          "type": "paragraph",
          "text": "ELECTROCARDIOGRAMME (ECG)"
        },
        {
          "type": "paragraph",
          "text": "Dérivations droites : analyse de la repolarization du right ventricle :"
        },
        {
          "type": "paragraph",
          "text": "V3R, symétrique de V3 à droite et V4R,symétrique de V4 à droite."
        },
        {
          "type": "paragraph",
          "text": "Dérivations postérieures V7 V8 V9 en partant du 5e espace"
        },
        {
          "type": "paragraph",
          "text": "intercostal gauche puis en remontant vers la pointe de l'omoplate gauche."
        },
        {
          "type": "heading",
          "level": 3,
          "text": "c- Dérivations non standards :"
        },
