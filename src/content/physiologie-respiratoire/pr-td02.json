    {
      "n": 27,
      "title": "? The nose is closed with a nose clip,",
      "blocks": [
        {
          "type": "paragraph",
          "text": "How to perform spirometry?"
        },
        {
          "type": "heading",
          "level": 3,
          "text": "? The nose is closed with a nose clip,"
        },
        {
          "type": "heading",
          "level": 3,
          "text": "? the patient breathes calmly,"
        },
        {
          "type": "paragraph",
          "text": "? then we ask him to breathe deeply: he inhales, deeply, and then exhales as hard and as quickly as possible all the air from his lungs into the spirometer."
        }
      ]
    },
    {
      "n": 28,
      "title": "How to perform spirometry",
      "blocks": [
        {
          "type": "paragraph",
          "text": "How to perform spirometry?"
        },
        {
          "type": "list",
          "items": [
            "Exhalation duration should be at least 6 seconds.",
            "Care should be taken to avoid perioral leaks.",
            "These simple maneuvers make it possible to measure lung volumes.",
            "To measure forced expiratory flow rates, the patient is asked to take in as much air as possible and then blow as hard and as long as they can to empty all the air they have in their lungs."
          ]
        }
      ]
